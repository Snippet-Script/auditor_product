{
  "name": "snippet-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node server/index.js",
    "dev:web": "vite",
    "dev:all": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview --open",
    "start": "node server/index.js",
    "serve:preview": "vite preview --host 0.0.0.0 --strictPort --port $PORT"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@react-oauth/google": "^0.12.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^10.13.1",
    "firebase-admin": "^12.5.0",
    "gpt-tokenizer": "^3.0.1",
    "jspdf": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.4",
    "vite": "^7.1.2"
  }
}
