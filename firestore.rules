rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User state: each user can read/write only their own document
    match /userStates/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Usage aggregates: user can read/write only their own aggregate
    match /usage/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // (Optional) Additional collections should be locked down by default
    match /{document=**} {
      allow read, write: if false; // deny all other unspecified access
    }
  }
}
